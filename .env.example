
# AgRefactor environment configuration.
# Copy to `.env` (`cp .env.example .env`) and fill in locally.
# `.env` is git-ignored. Never commit real credentials or private paths.

# ---------------------------------------------------------------------------
# LLM API access (OpenAI-compatible).
# Keep committed values blank; set real credentials only in local `.env`.
# ---------------------------------------------------------------------------

# Exact default for the committed deepseek-v4-flash runtime record.
DEEPSEEK_API_KEY=

# Generic OpenAI-compatible default for models without an exact runtime record.
OPENAI_API_KEY=

# Optional provider-specific names. Select one with --api-key-env when used.
MOONSHOT_API_KEY=
ZAI_API_KEY=
MINIMAX_API_KEY=
DASHSCOPE_API_KEY=

# A concrete model may provide its own endpoint default. Override explicitly
# with --base-url when using another deployment.
# OPENAI_BASE_URL=https://example.invalid/v1

# ---------------------------------------------------------------------------
# Output locations. Set these to absolute paths you own.
# --output-dir can override the persistent artifact directory for one run.
# ---------------------------------------------------------------------------
RUN_DIR=/abs/path/to/agrefactor/runs
WORK_DIR=/abs/path/to/scratch/runs

# ---------------------------------------------------------------------------
# Optional local Vitis launcher overrides.
# ---------------------------------------------------------------------------
# AGREFACTOR_VITIS_RUN=/abs/path/to/Xilinx/Vitis/2023.2/bin/vitis-run
# AGREFACTOR_VITIS_SETTINGS=/abs/path/to/Xilinx/Vitis/2023.2/settings64.sh

# ---------------------------------------------------------------------------
# HeteroRefactor compatibility integration (not used by the normal CLI).
# ---------------------------------------------------------------------------
HETEROREFACTOR_DIR=/abs/path/to/heterorefactor
# SCRATCH_DIR=/abs/path/to/scratch

# ---------------------------------------------------------------------------
# Optional remote HLS compatibility server.
# ---------------------------------------------------------------------------
# HLS_WORK_ROOT=/abs/path/to/remote_hls_work
# HLS_MAX_WORKERS=4
