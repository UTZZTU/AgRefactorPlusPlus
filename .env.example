# AgRefactor environment configuration.
# Copy to `.env` (`cp .env.example .env`) and fill in. `.env` is git-ignored.
# The flow loads this file automatically via python-dotenv.

# ---------------------------------------------------------------------------
# LLM API access (OpenAI-compatible). Required for all LLM-based agents.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here
# Optional: point at a non-OpenAI OpenAI-compatible endpoint (Gemini, vLLM, ...)
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ---------------------------------------------------------------------------
# Output locations. Set these to absolute paths you own.
# ---------------------------------------------------------------------------
# Base directory for run outputs and logs (per-run dirs are created underneath).
RUN_DIR=/abs/path/to/agrefactor/runs
# Optional scratch dir for intermediate work (defaults sensibly if unset).
WORK_DIR=/abs/path/to/scratch/runs

# ---------------------------------------------------------------------------
# HeteroRefactor tool integration (only needed with --hetero_enabled).
# This directory must contain `heterorefactor.sif` and the `heterorefactor/` repo.
# See containers/README.md to build the .sif from containers/heterorefactor.def.
# ---------------------------------------------------------------------------
HETEROREFACTOR_DIR=/abs/path/to/heterorefactor

# ---------------------------------------------------------------------------
# Optional: scratch dir for temporary HeteroRefactor work (defaults to system tmp).
# ---------------------------------------------------------------------------
# SCRATCH_DIR=/abs/path/to/scratch

# ---------------------------------------------------------------------------
# Optional: remote HLS server (scripts/hls_server.py).
# ---------------------------------------------------------------------------
# HLS_WORK_ROOT=/abs/path/to/remote_hls_work
# HLS_MAX_WORKERS=4
